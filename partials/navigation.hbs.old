{{#if isSecondary}}
<ul class="nav" role="menu">
    {{#foreach navigation}}
    <li class="nav-{{slug}}" role="menuitem">
        <a href="{{url}}">
            <svg class="icon" role="img" aria-label="{{slug}} icon">
                <title>{{slug}}</title>
                <use xlink:href="#{{slug}}"></use>
            </svg>
        </a>
    </li>
    {{/foreach}}
</ul>
{{else}}
    <nav class="navbar is-primary" role="navigation">

        <div class="navbar-brand">
            <div class="navbar-burger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <div class="navbar-menu">

            <div class="navbar-start">
                <!--{{#foreach navigation}}
                    <li class="{{link_class for=(url) class=(concat "nav-" slug)}} level-item" role="menuitem">
                        <a class="navbar-item is-justify-content-center" href="{{url absolute="true"}}"><b>{{label}}</b></a>
                    </li>
                    {{/foreach}}-->
                <a class="navbar-item" href="/">
                    Home
                </a>

                <div class="has-dropdown is-hoverable">
                    <a class="navbar-item" href="/">
                        About Us
                    </a>
                    <div class="navbar-dropdown">
                        <a class="navbar-item" href="guild-by-laws">
                            Guild By-Laws
                        </a>
                        <a class="navbar-item" href="code-of-conduct">
                            Code of Conduct
                        </a>
                    </div>
                </div>

                <div class="navbar-item has-dropdown is-hoverable">
                    <a class="navbar-item" href="/">
                        Members
                    </a>

                    <div class="navbar-dropdown">
                        <a class="navbar-item" href="member-directory">
                            Member Directory
                        </a>
                        <a class="navbar-item" href="join-us">
                            Join Us!
                        </a>
                    </div>
                </div>

                <a class="navbar-item" href="furry-writers-market">
                    Furry Writers Market
                </a>

                <div class="navbar-item has-dropdown is-hoverable">
                    <a class="navbar-link navbar-item" href="suggested-reading"><b>Suggested Reading</b></a>
                    <div class="navbar-dropdown">
                        <a class="navbar-item" href="where-to-purchase"><b>Where to Purchase</b></a>
                    </div>
                </div>
            </div>

            <div class="navbar-end">
                {{> social_media}}
            </div>

        </div>
    </nav>
{{/if}}