<footer class="footer">
    <div class="container">
        <div class="columns">
            <div class="column">
                {{#get "posts" limit="5" as |recent|}}
                <section class="recent-posts">
                    <h3>Recent Posts</h3>
                    <ul>
                        {{#foreach recent}}
                        <li>
                            <a href="{{url}}">{{title}}</a>
                        </li>
                        {{/foreach}}
                    </ul>
                </section>
                {{/get}}
            </div>

            <div class="column">
                {{#get "tags" limit="5" as |tags|}}
                    <section class="getting-started">
                        <h3>Tags</h3>
                        <ul>
                            {{#foreach tags}}
                                <li>
                                    <a href="{{url}}" class="tag is-dark">{{name}}</a>
                                </li>
                            {{/foreach}}
                        </ul>
                    </section>
                {{/get}}
            </div>
        </div>
    </div>
</footer>