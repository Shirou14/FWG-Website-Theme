<article class="guild-member-card column is-one-quarter">
    <a href="{{url}}" class="card mb-4">
        <div class="card-image">
            <figure class="image is-5by3" width="460px">
                <img src="{{feature_image}}" alt="{{title}} profile picture" style="object-fit: cover">
            </figure>
        </div>

        <div class="card-content py-3 px-1 has-text-centered has-background-white">
            <h1 class="title has-text-primary-dark is-4">{{title}}</h1>
        </div>
    </a>
</article>