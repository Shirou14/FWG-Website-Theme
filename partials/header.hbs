<header class="hero has-background-light has-background">
    <img alt="Furry Bookshelf" src="/assets/img/fwg-books.jpeg" class="hero-background is-transparent" />
    <div class="hero-head">
    </div>
    <div class="container hero-body">
        <div class="media">
            <figure class="media-left">
                <img src="{{@site.logo}}" alt="Furry Writers Guild Logo" id="hero-header-logo" class="image is-128x128">
            </figure>

            <div id="hero-header-titles" class="media-content is-hidden-mobile mt-4">
                <h1 class="title has-text-black is-size-2">{{@blog.title}}</h1>
                <h2 class="subtitle has-text-black has-text-weight-bold is-italic">{{@blog.description}}</h2>
            </div>
        </div>
    </div>
    <div class="hero-footer">
    </div>
</header>
<div>
    {{navigation}}
</div>
