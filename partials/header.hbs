<header class="hero has-background-light has-background">
    <img alt="Furry Bookshelf" src="../assets/img/fwg-books.jpeg" class="hero-background is-transparent" />
    <div class="hero-head">
    </div>
    <div class="hero-body">
        <div class="level">
            <div class="container level-right">
                <img src="{{@site.logo}}" alt="Furry Writers Guild Logo" id="hero-header-logo" class="image is-128x128">
                <div id="hero-header-titles">
                    <h1 class="title">{{@blog.title}}</h1>
                    <h2 class="subtitle">{{@blog.description}}</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-footer">
    </div>
</header>
<div>
    {{navigation}}
</div>
