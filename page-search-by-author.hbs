{{!< default}}

<main class="container">
    <div class="columns is-multiline my-3 mx-1">
        <div class="column side-bar is-one-fifth pr-0 is-hidden-touch">
            {{> contact_card}}
            {{> reach_out_card}}
        </div>

        <div class="column is-centered">
            <div class="columns is-multiline">
                {{#get "authors" order="name desc"}}
                    {{#foreach authors}}
                            {{> author_card}}
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </div>
</main>