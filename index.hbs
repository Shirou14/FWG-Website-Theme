{{!< default}}

<main class="container">
    {{#foreach posts}}
        {{#if featured}}
            {{> feature_card}}
        {{/if}}
    {{/foreach}}

    <div class="columns is-multiline pt-5 pb-5 mx-4">
        <div class="column side-bar is-one-fifth pr-0 is-hidden-touch">
            {{> contact_card}}
            {{> reach_out_card}}
        </div>

        <div class="column is-centered">
            {{pagination}}
            {{#foreach posts}}
                {{^if featured}}
                    {{> post_card}}
                {{/if}}
            {{/foreach}}
            {{pagination}}
        </div>
    </div>
</main>
