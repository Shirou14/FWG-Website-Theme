{{!< default}}

<main class="container">
    <div class="columns is-multiline pt-5 pb-5 mx-4">
        <div class="column side-bar is-one-fifth pr-0 is-hidden-touch">
            {{> contact_card}}
            {{> reach_out_card}}
        </div>

        <div class="column is-centered">
            <div class="columns is-multiline">
                {{#get "pages" include="tags" filter="primary_tag:guild-member" limit="all" order="title asc"}}
                    {{#foreach pages}}
                            {{> guild_member_card}}
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </div>
</main>