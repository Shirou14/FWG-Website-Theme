{{!< default}}

{{#post}}
    <article class="box container is-widescreen mt-5">
        <header class="post__background-image mb-6" style="background-image: url({{feature_image}})">
            <div class="post__background-image-text has-background-white">
                <h1 class="title is-1 is-size-4-mobile">{{title}}</h1>
                <h2 class="subtitle is-4 is-size-5-mobile">By {{#authors}}{{name}}{{/authors}}</h2>
            </div>
        </header>
        <section class="content has-text-dark mx-6 is-size-5 is-hidden-mobile">
            {{content}}
        </section>
        <section class="content has-text-dark is-size-6-mobile is-hidden-tablet">
            {{content}}
        </section>
    </article>
{{/post}}